# 环境变量配置文件
VITE_ENV=dev

# 端口号
VITE_SERVER_PORT=7000

# 跨域：/admin 前缀请求由 vite dev server 代理转发到后端，避免直连触发 CORS。
# 注意：后端路由本身就带 /admin/v1 前缀，故代理不做 rewrite，原样转发。
VITE_PROXY='[["/admin", "http://127.0.0.1:7788/"]]'

# API 基础地址：留空，使 axios 以相对路径发请求（/admin/v1/...），
# 由上方 VITE_PROXY 转发到后端，避免绝对地址直连触发 CORS。
VITE_API_URL=

# SSE地址
VITE_SSE_URL=http://localhost:7789/events
